# Google AI Studio key -> https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model for transcript highlight ranking + script writing
GEMINI_MODEL=gemini-3.6-flash

# Ordered fallback models tried if the primary 503/429s out. Older flash
# models (e.g. 2.5-flash) are 404 for this tier; flash-lite tiers work.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Local whisper model: tiny/base/small/medium/large-v3 (small = good balance)
WHISPER_MODEL=small
WHISPER_DEVICE=auto

# edge-tts voice (en-US default). List: https://github.com/rany2/edge-tts
TTS_VOICE=en-US-AvaNeural

# Stock b-roll for generated clips -> https://www.pexels.com/api/ (free key).
# Optional: without a key, generated clips use the gradient backplate fallback.
# PEXELS_API_KEY=

# Optional FFmpeg binary overrides. If unset, the encoder auto-detects the
# winget Gyan.FFmpeg install, then PATH. (Set only to force a specific build.)
# FFMPEG_BIN=C:\path\to\ffmpeg.exe
# FFPROBE_BIN=C:\path\to\ffprobe.exe

# Session cookie files (Netscape format) exported from a logged-in browser.
# TikTok  -> data/cookies.txt
COOKIES_FILE=data/cookies.txt

# YouTube (Studio automation) -> data/youtube_cookies.txt
# Export while logged into https://studio.youtube.com
YOUTUBE_COOKIES_FILE=data/youtube_cookies.txt

# Optional: absolute paths to a modern ffmpeg/ffprobe (must support `subtitles`,
# `gradients`, `drawtext`). If omitted, the winget Gyan build is auto-detected
# and then PATH is searched. Do NOT rely on a 2013-era pip ffmpeg.
FFMPEG_BIN=
FFPROBE_BIN=

# Gemini API retry tuning (transient 503/429 high-demand errors).
# GEMINI_MAX_RETRIES=6
# GEMINI_RETRY_DELAY=3
# GEMINI_RETRY_MAX_DELAY=45
# GEMINI_RETRY_TIMEOUT=90  # hard cap on total retry time per model

# ---- Clip look -------------------------------------------------------------
# Framing of landscape sources (repost clips):
#   auto  = pick per clip: follow the speaker's face / stack facecam over
#           gameplay / fall back when there is no face          (default)
#   track = always follow the face     stack = facecam on top, gameplay below
#   blur  = whole picture over a blurred copy     crop = plain centre crop
# CLIP_LAYOUT=auto
# CLIP_FALLBACK_LAYOUT=crop    # what "auto" uses with no face: crop | blur
# STACK_SPLIT=0.36             # share of the height given to the facecam

# Burnt-in captions (repost + generated clips).
#   pop   = bold uppercase 2-3 word phrases, spoken word pops in colour (default)
#   word  = one huge word at a time
#   clean = calmer sentence-case lines (talky / educational content)
# CAPTION_STYLE=pop
# Any of these override the chosen style:
# CAPTION_FONT=Montserrat Black   # bundled; or any font installed on this PC
# CAPTION_FONT_SIZE=92
# CAPTION_MAX_WORDS=3             # words per phrase
# CAPTION_MAX_LINE_CHARS=13       # wrap / shrink beyond this many characters
# CAPTION_Y=0.68                  # vertical centre, 0 = top .. 1 = bottom
# CAPTION_UPPERCASE=1
# CAPTION_HIGHLIGHT=1             # colour the word being spoken
# CAPTION_WORD_POP=110            # % size of the spoken word (100 = off)
# CAPTION_COLOUR=#FFFFFF
# HIGHLIGHT_COLOUR=#FFE600
# CAPTION_OUTLINE_COLOUR=#000000
# CAPTION_OUTLINE=7
# CAPTION_SHADOW=3
# HOOK_SECONDS=3.0                # title card at the top of the clip; 0 = off
# HOOK_Y=0.15

# Timing / audio / encode.
# SNAP_TO_WORDS=1                 # never start or end a clip mid-word
# AUDIO_NORMALIZE=1               # loudness-normalise to -14 LUFS
# VIDEO_CRF=18                    # lower = higher quality, bigger file
# VIDEO_PRESET=veryfast           # slower presets = smaller files, same look
# VIDEO_MAX_FPS=60

# TikTok Content Posting API (only for "backend": "api" in config/tiktok.json).
# Create an app at https://developers.tiktok.com/ (Login Kit + Content Posting API).
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
