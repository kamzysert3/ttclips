# Google AI Studio key -> https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model for transcript highlight ranking + script writing
GEMINI_MODEL=gemini-3.6-flash

# Ordered fallback models tried if the primary 503/429s out. Older flash
# models (e.g. 2.5-flash) are 404 for this tier; flash-lite tiers work.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Local whisper model: tiny/base/small/medium/large-v3 (small = good balance)
WHISPER_MODEL=small
WHISPER_DEVICE=auto

# edge-tts voice (en-US default). List: https://github.com/rany2/edge-tts
TTS_VOICE=en-US-AvaNeural

# Stock b-roll for generated clips -> https://www.pexels.com/api/ (free key).
# Optional: without a key, generated clips use the gradient backplate fallback.
# PEXELS_API_KEY=

# Optional FFmpeg binary overrides. If unset, the encoder auto-detects the
# winget Gyan.FFmpeg install, then PATH. (Set only to force a specific build.)
# FFMPEG_BIN=C:\path\to\ffmpeg.exe
# FFPROBE_BIN=C:\path\to\ffprobe.exe

# What posts at each slot. TikTok session cookie file (Netscape format).
COOKIES_FILE=data/cookies.txt

# Optional: absolute paths to a modern ffmpeg/ffprobe (must support `subtitles`,
# `gradients`, `drawtext`). If omitted, the winget Gyan build is auto-detected
# and then PATH is searched. Do NOT rely on a 2013-era pip ffmpeg.
FFMPEG_BIN=
FFPROBE_BIN=

# Gemini API retry tuning (transient 503/429 high-demand errors).
# GEMINI_MAX_RETRIES=6
# GEMINI_RETRY_DELAY=3
# GEMINI_RETRY_MAX_DELAY=45
# GEMINI_RETRY_TIMEOUT=90  # hard cap on total retry time per model

# Burnt-in caption styling (repost + generated clips). Captions are big,
# dead-center and karaoke-highlight the active word (bold + HIGHLIGHT_COLOUR).
# CAPTION_FONT_SIZE=96
# CAPTION_ALIGNMENT=5          # 5 = middle-center
# CAPTION_MARGINV=0
# CAPTION_OUTLINE=3
# CAPTION_SHADOW=2
# CAPTION_WORDS_PER_LINE=6     # max words per caption line (repost clips)
# HIGHLIGHT_COLOUR=0000FFFF    # ASS BGR; 0000FFFF = yellow
# IDLE_COLOUR=00808080         # ASS BGR; light grey for the rest of the line